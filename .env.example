# =============================================================================
# LMS PLATFORM ENTERPRISE - ENVIRONMENT TEMPLATE
# =============================================================================
# Salin file ini menjadi .env dan sesuaikan nilai rahasia untuk environment Anda.
# =============================================================================

# --- PROJECT & ENVIRONMENT ---
PROJECT_NAME="LMS Platform Enterprise"
ENVIRONMENT=production # production | development | staging
DEBUG=False
VERSION=1.5.0

# --- DOMAIN & CORS CONFIGURATION ---
DOMAIN=lms.consep33t.my.id
FRONTEND_URL=https://lms.consep33t.my.id
PUBLIC_URL=https://lms.consep33t.my.id
BACKEND_CORS_ORIGINS=["https://lms.consep33t.my.id","http://localhost:3000","http://localhost:5173"]

# --- DATABASE CONFIGURATION (MICROSOFT SQL SERVER) ---
DB_SERVER=lms_database
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=LmsProdSecret2026!
DB_NAME=lms_db
DB_DRIVER="ODBC Driver 18 for SQL Server"
DB_TRUST_CERT=yes

# --- CACHE & BROKER (REDIS) ---
REDIS_HOST=lms_redis
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
CELERY_BROKER_URL=redis://lms_redis:6379/1
CELERY_RESULT_BACKEND=redis://lms_redis:6379/2

# --- JWT AUTHENTICATION & SECURITY ---
SECRET_KEY=change_this_to_a_very_long_and_secure_random_secret_string_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- STORAGE BACKEND (MINIO / AWS S3 / LOCAL) ---
STORAGE_DRIVER=local # local | s3
STORAGE_LOCAL_BASE_PATH=/data/uploads
STORAGE_PUBLIC_BASE_URL=https://lms.consep33t.my.id
STORAGE_SIGNING_SECRET=storage_signing_secret_key_32_chars

# Konfigurasi S3 / MinIO (Jika STORAGE_DRIVER=s3)
S3_ENDPOINT_URL=http://shared-minio:9010
S3_ACCESS_KEY=admin
S3_SECRET_KEY=SuperSecretPassword123
S3_BUCKET_NAME=lms
S3_USE_SSL=False

# --- WHATSAPP GATEWAY INTEGRATION ---
WA_GATEWAY_URL=http://192.168.10.100:3333
WA_GATEWAY_ENABLED=True

# --- EMAIL / SMTP GATEWAY NOTIFICATION ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@lms.consep33t.my.id
SMTP_FROM_NAME="LMS Enterprise Academy"
EMAILS_ENABLED=True

# --- GOOGLE OAUTH2 AUTHENTICATION ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

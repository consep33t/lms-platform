# =============================================================================
# LMS PLATFORM ENTERPRISE - ENVIRONMENT TEMPLATE
# =============================================================================
# Salin file ini menjadi .env dan sesuaikan nilai rahasia untuk environment Anda.
# JANGAN PERNAH MENYIMPAN ATAU MELAKUKAN COMMIT FILE .env YANG BERISI KREDENSIAL ASLI KE GIT!
# =============================================================================

# --- PROJECT & ENVIRONMENT ---
PROJECT_NAME="LMS Platform Enterprise"
ENVIRONMENT=production # production | development | staging
DEBUG=False
VERSION=1.4.0

# --- DOMAIN & CORS CONFIGURATION ---
DOMAIN=lms.example.com
PUBLIC_URL=https://lms.example.com
BACKEND_CORS_ORIGINS=["https://lms.example.com","http://localhost:3000","http://localhost:5173"]

# --- DATABASE CONFIGURATION (MICROSOFT SQL SERVER) ---
DB_SERVER=lms_database
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrongDatabasePassword123!
DB_NAME=lms_db
DB_DRIVER="ODBC Driver 18 for SQL Server"
DB_TRUST_CERT=yes

# --- CACHE & BROKER (REDIS) ---
REDIS_HOST=lms_redis
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
CELERY_BROKER_URL=redis://lms_redis:6379/1
CELERY_RESULT_BACKEND=redis://lms_redis:6379/2

# --- JWT AUTHENTICATION & SECURITY ---
# Hasilkan secret key acak 64-karakter yang kuat: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_very_long_and_secure_random_secret_string_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- STORAGE BACKEND (MINIO / AWS S3 / LOCAL) ---
STORAGE_PROVIDER=local # local | s3
LOCAL_STORAGE_PATH=/data/uploads

# Konfigurasi S3 / MinIO (Jika STORAGE_PROVIDER=s3)
S3_ENDPOINT_URL=http://shared_minio:9010
S3_ACCESS_KEY=your_minio_access_key
S3_SECRET_KEY=your_minio_secret_key
S3_BUCKET_NAME=lms
S3_REGION=us-east-1
S3_USE_SSL=False

# --- EMAIL / SMTP NOTIFICATION (OPTIONAL) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=your_smtp_app_password
EMAILS_FROM_EMAIL=no-reply@example.com
EMAILS_FROM_NAME="LMS Admin Notification"

# --- RATE LIMITING & SECURITY THRESHOLDS ---
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_API="120/minute"
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly declare text files
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.html text eol=lf
*.css text eol=lf
Dockerfile* text eol=lf
.env* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.pdf binary
*.ico binary
*.woff binary
*.woff2 binary

# =============================================================================
# LMS PLATFORM ENTERPRISE - ENVIRONMENT TEMPLATE
# =============================================================================
# Salin file ini menjadi .env dan sesuaikan nilai rahasia untuk environment Anda.
# JANGAN PERNAH MENYIMPAN ATAU MELAKUKAN COMMIT FILE .env YANG BERISI KREDENSIAL ASLI KE GIT!
# =============================================================================

# --- PROJECT & ENVIRONMENT ---
PROJECT_NAME="LMS Platform Enterprise"
ENVIRONMENT=production # production | development | staging
DEBUG=False
VERSION=1.4.0

# --- DOMAIN & CORS CONFIGURATION ---
DOMAIN=lms.example.com
PUBLIC_URL=https://lms.example.com
BACKEND_CORS_ORIGINS=["https://lms.example.com","http://localhost:3000","http://localhost:5173"]

# --- DATABASE CONFIGURATION (MICROSOFT SQL SERVER) ---
DB_SERVER=lms_database
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrongDatabasePassword123!
DB_NAME=lms_db
DB_DRIVER="ODBC Driver 18 for SQL Server"
DB_TRUST_CERT=yes

# --- CACHE & BROKER (REDIS) ---
# REDIS_URL digunakan langsung oleh config.py - format: redis://<host>:<port>/<db>
REDIS_URL=redis://lms_redis:6379/0
CELERY_BROKER_URL=redis://lms_redis:6379/1
CELERY_RESULT_BACKEND=redis://lms_redis:6379/2

# --- JWT AUTHENTICATION & SECURITY ---
# Hasilkan secret key acak 64-karakter yang kuat: python -c "import secrets; print(secrets.token_hex(32))"
# KRITIS: Variabel ini harus bernama SECRET_KEY (bukan JWT_SECRET_KEY)
SECRET_KEY=change_this_to_a_very_long_and_secure_random_secret_string_min_64chars
# KRITIS: Variabel ini harus bernama ALGORITHM (bukan JWT_ALGORITHM)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=https://lms.example.com

# --- STORAGE BACKEND (MINIO / AWS S3 / LOCAL) ---
# KRITIS: Gunakan STORAGE_DRIVER (bukan STORAGE_PROVIDER)
STORAGE_DRIVER=local # local | s3
# KRITIS: Gunakan STORAGE_LOCAL_BASE_PATH (bukan LOCAL_STORAGE_PATH)
STORAGE_LOCAL_BASE_PATH=/data/uploads
STORAGE_PUBLIC_BASE_URL=https://lms.example.com
STORAGE_SIGNING_SECRET=change_this_storage_signing_secret_min_32_chars

# Konfigurasi S3 / MinIO (Jika STORAGE_DRIVER=s3)
S3_ENDPOINT_URL=http://shared_minio:9010
S3_ACCESS_KEY=your_minio_access_key
S3_SECRET_KEY=your_minio_secret_key
S3_BUCKET_NAME=lms
S3_USE_SSL=False

# --- EMAIL / SMTP NOTIFICATION ---
EMAILS_ENABLED=True
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=noreply@lms.example.com
SMTP_FROM_NAME="LMS Enterprise Academy"

# --- GOOGLE OAUTH2 ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- WHATSAPP GATEWAY ---
WA_GATEWAY_URL=http://wa-gateway-api:3333
WA_GATEWAY_ENABLED=True

# --- RATE LIMITING & SECURITY THRESHOLDS ---
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_API="120/minute"
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# App
APP_NAME=LMS Platform
DEBUG=true
SECRET_KEY=change-this-to-a-long-random-secret-key

# Database (MSSQL)
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_NAME=lms_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_BASE_PATH=/data/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8000
STORAGE_SIGNING_SECRET=change-this-to-another-random-secret

# S3/MinIO (optional, activate with STORAGE_DRIVER=s3)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_USE_SSL=false

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS
CORS_ORIGINS=["http://localhost:5173"]
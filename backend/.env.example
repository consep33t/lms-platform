# ==============================================================================
# LMS ENTERPRISE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Settings
APP_NAME=LMS Enterprise Platform
APP_VERSION=3.9.0
DEBUG=false
SECRET_KEY=your_64_char_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=https://lms.consep33t.my.id

# Database Settings (MSSQL)
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrongDatabasePassword!
DB_NAME=lms_db

# Redis & Celery Settings
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object Storage Settings (MinIO / S3)
STORAGE_DRIVER=s3
STORAGE_LOCAL_BASE_PATH=/data/uploads
STORAGE_PUBLIC_BASE_URL=https://minio.consep33t.my.id
STORAGE_SIGNING_SECRET=your_storage_signing_secret_here
S3_ENDPOINT_URL=https://minio.consep33t.my.id:9000
S3_ACCESS_KEY=your_minio_access_key
S3_SECRET_KEY=your_minio_secret_key
S3_BUCKET_NAME=lms-storage
S3_USE_SSL=true

# Upload Limits (Bytes)
MAX_IMAGE_SIZE=10485760
MAX_DOCUMENT_SIZE=52428800
MAX_VIDEO_SIZE=1073741824

# Google OAuth2 Authentication
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# SMTP Email Gateway
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=noreply@lms.consep33t.my.id
SMTP_FROM_NAME="LMS Enterprise Academy"
EMAILS_ENABLED=true

# WhatsApp Gateway
WA_GATEWAY_URL=http://localhost:3333
WA_GATEWAY_ENABLED=true

# Payment Gateway (Midtrans & Stripe)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxx
MIDTRANS_IS_PRODUCTION=false
STRIPE_SECRET_KEY=sk_test_xxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxx

# PWA Web Push (VAPID Keys)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@lms.consep33t.my.id
